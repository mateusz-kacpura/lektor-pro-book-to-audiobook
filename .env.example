# ==============================================================================
# LEKTOR - Konfiguracja Środowiskowa (.env)
# ==============================================================================

# --- Ścieżki danych (Single Source of Truth) ---
# Główny katalog danych (domyślnie: ./data w katalogu projektu)
LEKTOR_DATA_DIR=data

# --- Aktywna książka (Slug) ---
# Nazwa katalogu aktywnej książki w data/books/<slug>
LEKTOR_ACTIVE_BOOK=cloud_native_go

# --- Urządzenie obliczeniowe ---
# Opcje: auto (automatyczna detekcja CUDA / fallback CPU), cuda, cpu
LEKTOR_DEVICE=auto

# --- Konfiguracja Web GUI (FastAPI / Uvicorn) ---
LEKTOR_GUI_HOST=127.0.0.1
LEKTOR_GUI_PORT=7860
LEKTOR_AUTO_OPEN_BROWSER=true

# --- Identyfikatory modeli AI / ML ---
LEKTOR_CHATTERBOX_MODEL=ResembleAI/chatterbox
LEKTOR_MINERU_MODEL=opendatalab/MinerU2.5-Pro-2604-1.2B

# --- Model wizyjny AI (Multimodal OCR & Translation) ---
# Domyślnie Google DeepMind Gemma 4 12B w LM Studio (:1234) lub Ollama (:11434)
LEKTOR_VISION_MODEL=google/gemma-4-12b
LEKTOR_VISION_API_URL=http://127.0.0.1:1234/v1
